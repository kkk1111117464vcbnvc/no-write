"VertexLitGeneric"
{
	"$nodecal" "1"
    "$basetexture" "models/player/likeaworm/shrek/brows"
    "$bumpmap" "models/player/likeaworm/shrek/brows_normal"



    "$phong" "1"
    "$phongboost" "0.06"
$phongexponent 8
    "$phongalbedotint" "1"
    "$phongalbedoboost" "10"                                //toy around with this
    "$phongfresnelranges" "[1 0.1 0]"

$alphatest 1
$alphatestreference		0.2

    //rimlight doesn't properly show in hlmv, make sure you're changing these values in game
    "$rimlight" "1"
    "$rimlightexponent" "100"
    "$rimmask" "1"
    "$rimlightboost" "1"
       
    /////////////////
    "$normalmapalphaenvmapmask" "1"                         //do not touch this
    /////////////////
}